# LLM Provider: anthropic | openai | gemini | ollama
LLM_PROVIDER=anthropic

# API Keys (set the one matching your provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional overrides
LLM_MODEL=
# Comma-separated models tried in order when the primary fails (e.g. quota).
# For Gemini free tier each model has its own daily bucket, so listing a few
# extends your free daily budget. Example: gemini-2.0-flash,gemini-3-flash-preview
LLM_FALLBACK_MODELS=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Reuse a generated answer to the same application question for this many seconds
# (0 or empty = forever). Answers you reviewed/edited never expire.
ANSWER_CACHE_TTL=

# Password the extension types into "Create account" / "Sign in" pages of
# application sites (the e-mail is personal.email from profile.yaml). Empty = off.
ATS_ACCOUNT_PASSWORD=

# Read-only Gmail integration (verification codes for sign-ups).
# ONLY this mailbox may be connected; a token for any other account is rejected.
GMAIL_ACCOUNT=
